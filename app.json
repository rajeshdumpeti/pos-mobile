{
  "expo": {
    "name": "POS",
    "slug": "personal-operating-system",
    "scheme": "pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.personaloperatingsystem.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.personaloperatingsystem.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-icon-monochrome.png",
        "backgroundColor": "#302344"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "backgroundColor": "#F4F3EF",
      "resizeMode": "contain"
    },
    "extra": {
      "eas": {
        "projectId": "7eda4110-a762-4d91-b02e-646e9ff2c1fa"
      }
    },
    "owner": "rajesh05db",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false
    }
  }
}
