{
  "name": "pos-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": "22.14.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "config:public": "expo config --type public",
    "auth:readiness": "node scripts/auth-readiness-check.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:validate": "node scripts/brand-validate.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "doctor": "expo-doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-typescript src/api/contract/openapi.json --output src/api/generated/schema.ts && prettier --write src/api/generated/schema.ts",
    "api:check": "node scripts/api-check.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@hookform/resolvers": "5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.31",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.22",
    "expo-dev-client": "57.0.20",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "26.1.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.14",
    "eslint": "9.39.5",
    "expo-doctor": "1.20.1",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "openapi-typescript": "7.13.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "jest": {
    "preset": "jest-expo",
    "watchman": false,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/src/test/styleMock.ts",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
